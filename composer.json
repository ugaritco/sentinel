{
    "name": "ugarit/sentinel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        },
        {
            "name": "Mior Muhammad Zaki",
            "email": "mior@ugarit.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "ext-json": "*",
        "heritage/container": "^1.00.00"
    },
    "require-dev": {
        "ugarit/pint": "^1.00.00",
        "orchestra/testbench": "^6.47.1|^7.56|^8.37|^9.16|^10.9|^11.0",
        "phpstan/phpstan": "^2.1.33"
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Sentinel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "App\\": "workbench/app/",
            "Database\\Factories\\": "workbench/database/factories/",
            "Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "ugarit": {
            "providers": [
                "Ugarit\\Sentinel\\SentinelServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare",
            "@sync"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "sync": [
            "@php vendor/bin/testbench workbench:sync --ansi",
            "@php vendor/bin/testbench vendor:publish --tag=ugarit-assets --ansi"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
